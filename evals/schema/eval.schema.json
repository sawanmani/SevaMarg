{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seva-marg.local/schema/eval.schema.json",
  "title": "Seva-Marg evaluation question",
  "description": "One row of the accuracy/refusal benchmark. Field names here must match catalogue fields, because the answer composer's output is scored field by field - that is what keeps 'we measured it' honest.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "ask"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^(hi|en|oos)-[0-9]{3}$" },
      "ask": { "type": "string", "minLength": 3 },
      "lang": { "enum": ["hi", "en"] },
      "service": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "intent": {
        "enum": ["eligibility", "documents", "fees", "sla", "channel", "office", "escalation", "next_steps", "status_lookup", "faqs", "overview"]
      },
      "expect_fields": {
        "type": "array",
        "minItems": 1,
        "items": { "enum": ["eligibility", "documents", "fees", "sla", "channel", "office", "escalation", "next_steps", "faqs"] }
      },
      "must_not_say": { "type": "array", "items": { "type": "string" } },
      "twin_of": { "type": "string", "pattern": "^hi-[0-9]{3}$", "description": "the Hindi question this English one must answer identically - this is how the HI/EN parity claim stays measurable" },
      "why": { "type": "string" }
    },
    "allOf": [
      { "if": { "required": ["id"], "properties": { "id": { "pattern": "^oos-" } } }, "then": { "required": ["why"] } },
      { "if": { "properties": { "id": { "pattern": "^(hi|en)-" } } }, "then": { "required": ["service"] } }
    ]
  }
}
