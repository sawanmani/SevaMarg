{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seva-marg.local/schema/service.schema.json",
  "title": "Seva-Marg citizen service catalogue entry",
  "description": "One government service. Every fact-carrying node MUST carry source_url + verified_on. The validator (packages/catalogue/validate.mjs) fails the build on any missing citation or on the literal value VERIFY_OFFICIAL.",
  "type": "object",
  "required": ["service_id", "state", "district_scope", "lang", "eligibility", "documents", "fees", "sla", "channel", "office", "next_steps", "faqs", "stale_after_days", "confidence_floor"],
  "additionalProperties": false,
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["hi", "en"],
      "properties": {
        "hi": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date the value was read from the official source."
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Official page only: e-District UP, *.nic.in, UP CSC / state e-gov citizen charter. Not a news article, not a blog."
    }
  },
  "properties": {
    "service_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "state": { "const": "UP" },
    "district_scope": { "type": "string", "description": "'state' or a district code" },
    "lang": {
      "type": "object",
      "required": ["hi", "en"],
      "properties": {
        "hi": { "type": "object", "required": ["name", "aliases"], "properties": { "name": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" }, "description": "Colloquial phrasings used for intent matching, e.g. 'income certificate ka form'" } } },
        "en": { "type": "object", "required": ["name", "aliases"], "properties": { "name": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "eligibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "source_url", "verified_on"],
        "properties": {
          "text": { "$ref": "#/definitions/bilingual" },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "who", "source_url", "verified_on"],
        "properties": {
          "item": { "$ref": "#/definitions/bilingual" },
          "who": { "enum": ["applicant", "guardian", "either"] },
          "copies": { "type": "integer", "minimum": 0 },
          "attestation": { "type": "boolean" },
          "format": { "type": "string", "description": "original / self-attested copy / photo" },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "fees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "amount_inr", "mode", "source_url", "verified_on"],
        "properties": {
          "item": { "$ref": "#/definitions/bilingual" },
          "amount_inr": { "type": "number", "minimum": 0 },
          "mode": { "enum": ["online", "cash", "either"] },
          "free_below_income_inr": { "type": ["number", "null"] },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "sla": {
      "type": "object",
      "required": ["days", "scope", "source_url", "verified_on"],
      "properties": {
        "days": { "type": "integer", "minimum": 0 },
        "scope": { "$ref": "#/definitions/bilingual", "description": "from application to delivery, or from verification to delivery - state which" },
        "source_url": { "$ref": "#/definitions/sourceUrl" },
        "verified_on": { "$ref": "#/definitions/date" }
      }
    },
    "channel": {
      "type": "array",
      "minItems": 1,
      "description": "The step-reduction baseline. Hand-counted from the official page in Phase 1.5.",
      "items": {
        "type": "object",
        "required": ["kind", "steps", "source_url", "verified_on"],
        "properties": {
          "kind": { "enum": ["online", "csc", "tehsil", "dm_office"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["n", "action", "needs_visit"],
              "properties": {
                "n": { "type": "integer", "minimum": 1 },
                "action": { "$ref": "#/definitions/bilingual" },
                "needs_visit": { "type": "boolean", "description": "counts physical trips - the stronger unit than taps" }
              }
            }
          },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "office": {
      "type": "object",
      "required": ["type", "how_to_find", "source_url", "verified_on"],
      "properties": {
        "type": { "type": "array", "items": { "enum": ["tehsil", "csc", "dm_office", "village_pradh"] } },
        "how_to_find": { "$ref": "#/definitions/bilingual" },
        "source_url": { "$ref": "#/definitions/sourceUrl" },
        "verified_on": { "$ref": "#/definitions/date" }
      }
    },
    "escalation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "do", "source_url", "verified_on"],
        "properties": {
          "when": { "$ref": "#/definitions/bilingual" },
          "do": { "$ref": "#/definitions/bilingual" },
          "contact": { "type": "string", "description": "verified helpline number/portal only" },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "description": "'what happens next' - the thing the brief says citizens cannot find out",
      "items": {
        "type": "object",
        "required": ["status", "means", "source_url", "verified_on"],
        "properties": {
          "status": { "enum": ["applied", "verified", "approved", "delivered", "rejected"] },
          "means": { "$ref": "#/definitions/bilingual" },
          "eta_days": { "type": ["integer", "null"] },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q", "a", "source_url", "verified_on"],
        "properties": {
          "q": { "$ref": "#/definitions/bilingual" },
          "a": { "$ref": "#/definitions/bilingual" },
          "source_url": { "$ref": "#/definitions/sourceUrl" },
          "verified_on": { "$ref": "#/definitions/date" }
        }
      }
    },
    "stale_after_days": { "type": "integer", "minimum": 30, "maximum": 365 },
    "confidence_floor": { "type": "number", "minimum": 0.5, "maximum": 1 }
  }
}
